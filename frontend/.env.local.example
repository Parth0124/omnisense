# Copy to `.env.local`. Only NEXT_PUBLIC_* variables reach the browser -
# never put a secret behind that prefix.

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=OmniSense
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# Server-side only: target for the /api/backend/* rewrite in next.config.mjs.
API_PROXY_TARGET=http://localhost:8000
