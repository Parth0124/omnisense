# =============================================================================
#  OmniSense — environment configuration
#
#  Copy to `.env` and edit:   make env    (or:  cp .env.example .env)
#  `.env` is git-ignored. Never commit it.
#
#  This file is the mirror of `backend/core/config.py`, which is the ONLY module
#  that reads the environment. Every variable below is validated at startup — an
#  invalid value stops the process with an explanatory error rather than failing
#  later in a worker.
#
#  Conventions used throughout:
#    [REQUIRED]  you must supply this before the relevant feature works
#    options:    the complete set of accepted values
#    default:    what you get if the line is absent
# =============================================================================


# #############################################################################
#  0. WHAT I NEED FROM YOU
#
#  Everything else in this file has a working local default. These do not.
#  Nothing here is needed to run `make up` and start the datastores — only to
#  make the platform actually do work.
#
#  ---------------------------------------------------------------------------
#  To boot the API and frontend against local datastores:   nothing. Skip ahead.
#
#  To run agents / generate reports:
#    [1] ANTHROPIC_API_KEY        console.anthropic.com -> API keys
#
#  To ingest anything (Phase 1 connectors):
#    [2] REDDIT_CLIENT_ID         reddit.com/prefs/apps -> create a "script" app
#    [3] REDDIT_CLIENT_SECRET     same screen
#    [4] NEWS_API_KEY             optional; RSS needs no key at all
#
#  To store raw payloads and rendered reports durably:
#    [5] R2_ENDPOINT_URL          Cloudflare dashboard -> R2 -> bucket -> S3 API
#    [6] R2_ACCESS_KEY_ID         Cloudflare -> R2 -> Manage API tokens
#    [7] R2_SECRET_ACCESS_KEY     shown once at token creation
#
#  To embed text for semantic retrieval:
#    [8] EMBEDDING_PROVIDER + EMBEDDING_MODEL + the matching key
#        UNRESOLVED DECISION — see §10. This choice fixes the Qdrant collection
#        geometry; changing it later forces a full re-embed of every Signal.
#
#  Before any non-local deployment:
#    [9] SECRET_KEY               generate, see §2
#   [10] CREDENTIAL_ENCRYPTION_KEY generate, see §2
#
#  Startup refuses to proceed if OMNISENSE_ENV is `staging` or `prod` while
#  [9] or [10] are still placeholders.
# #############################################################################


# =============================================================================
#  1. RUNTIME
# =============================================================================

# Which environment this process believes it is running in. `staging` and `prod`
# enable the production safety checks in backend/core/config.py.
# options: local | dev | staging | prod
OMNISENSE_ENV=local

# options: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# `console` is human-readable and coloured; `json` emits one object per line for
# log shipping. Required to be `json` in staging/prod.
# options: console | json
LOG_FORMAT=console

API_HOST=0.0.0.0
API_PORT=8000

# Uvicorn worker processes. Keep at 1 locally so `--reload` works. In production
# this is usually (2 x cores) + 1, but prefer more replicas over more workers.
API_WORKERS=1

# Comma-separated exact origins. `*` is rejected in staging/prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000


# =============================================================================
#  2. SECURITY                                                    [REQUIRED prod]
# =============================================================================

# Signs session tokens. Rotating it invalidates every issued token.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# options: HS256 | HS384 | HS512 | RS256 | RS384 | RS512 | ES256 | ES384 | EdDSA
# HS* use SECRET_KEY directly. RS*/ES*/EdDSA need a key pair and are the right
# choice only once tokens are issued by something other than this service.
JWT_ALGORITHM=HS256

ACCESS_TOKEN_TTL_SECONDS=3600

# Encrypts connector credentials at rest. Must be a valid Fernet key: 44 url-safe
# base64 characters ending in `=`. Startup validates the shape.
# LOSING THIS MEANS EVERY STORED CONNECTOR CREDENTIAL IS UNRECOVERABLE.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=change-me


# =============================================================================
#  3. POSTGRESQL — transactional metadata (ADR-0004)
# =============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=omnisense
POSTGRES_USER=omnisense
POSTGRES_PASSWORD=omnisense

# MUST name an async driver. `postgresql://` selects psycopg2, whose blocking
# calls stall the event loop and present as a mysteriously slow database.
# Startup rejects the sync form.
# options: postgresql+asyncpg://... | postgresql+psycopg://...
DATABASE_URL=postgresql+asyncpg://omnisense:omnisense@localhost:5432/omnisense

POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=5

# Three different ceilings that are easy to confuse:
#   POOL_TIMEOUT    how long to wait for a free connection from the pool
#   CONNECT_TIMEOUT how long to wait for the TCP connect itself (asyncpg's own
#                   default is 60s — far too long to notice a dead host)
#   COMMAND_TIMEOUT how long a single statement may run before being cancelled
POSTGRES_POOL_TIMEOUT_SECONDS=30
POSTGRES_CONNECT_TIMEOUT_SECONDS=10
POSTGRES_COMMAND_TIMEOUT_SECONDS=60

# Logs every statement *including bound parameters*. Debugging only — rejected
# in staging/prod because parameters contain ingested content.
# options: true | false
POSTGRES_ECHO_SQL=false


# =============================================================================
#  4. REDIS — cache, rate limits, dedup sets, session state (ADR-0005)
# =============================================================================

# options: redis://host:port/db | rediss://... (TLS) | unix:///path/to/socket
REDIS_URL=redis://localhost:6379/0

REDIS_CACHE_TTL_SECONDS=3600
REDIS_MAX_CONNECTIONS=50


# =============================================================================
#  5. NEO4J — knowledge graph (ADR-0002)
# =============================================================================

# options: bolt://host:7687 | bolt+s://... (TLS) | neo4j://... (routing, cluster)
#          | neo4j+s://... (routing + TLS, e.g. Aura)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=omnisense
NEO4J_DATABASE=neo4j
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SECONDS=30


# =============================================================================
#  6. QDRANT — vector store (ADR-0003)
# =============================================================================

QDRANT_URL=http://localhost:6333

# Blank for the local container; required for Qdrant Cloud.
QDRANT_API_KEY=

QDRANT_COLLECTION=omnisense_signals

# Fixed when the collection is created. Changing it requires dropping and
# rebuilding the collection. `cosine` is correct for every normalized text
# embedding model in common use.

# options: cosine | dot | euclid | manhattan
QDRANT_DISTANCE=cosine

# gRPC is measurably faster for bulk upsert; REST is easier to debug.
# options: true | false
QDRANT_PREFER_GRPC=false

QDRANT_TIMEOUT_SECONDS=30


# =============================================================================
#  7. OPENSEARCH — keyword / BM25 retrieval
# =============================================================================

OPENSEARCH_URL=http://localhost:9200

# Blank locally: the dev container runs with the security plugin disabled.
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

OPENSEARCH_SIGNAL_INDEX=omnisense-signals
OPENSEARCH_TIMEOUT_SECONDS=30

# options: true | false   (false only for local self-signed certificates)
OPENSEARCH_VERIFY_CERTS=true


# =============================================================================
#  8. KAFKA / REDPANDA — event log (ADR-0007)
# =============================================================================

# Host access to the local Redpanda container is on 19092; 9092 is the
# container-internal listener used by the `apps` compose profile.
KAFKA_BOOTSTRAP_SERVERS=localhost:19092

KAFKA_CONSUMER_GROUP=omnisense

# options: PLAINTEXT | SSL | SASL_PLAINTEXT | SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Only used when SECURITY_PROTOCOL starts with SASL_.
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Where a brand-new consumer group starts. `earliest` replays the retained log,
# which is what you want for a new worker that must not miss data.
# options: earliest | latest
KAFKA_AUTO_OFFSET_RESET=earliest

KAFKA_MAX_POLL_RECORDS=100

# Topic names. Change only in lockstep across every producer and consumer.
KAFKA_TOPIC_RAW_RECORDS=omnisense.records.raw
KAFKA_TOPIC_SIGNALS=omnisense.signals.enriched
KAFKA_TOPIC_GRAPH_UPDATES=omnisense.graph.updates
KAFKA_TOPIC_DLQ=omnisense.dlq


# =============================================================================
#  9. OBJECT STORAGE — Cloudflare R2 via the S3 API (ADR-0006)   [REQUIRED 5-7]
# =============================================================================

# https://<account-id>.r2.cloudflarestorage.com
# Any S3-compatible endpoint works: AWS S3, MinIO, Backblaze B2, Wasabi.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=omnisense

# R2 ignores region and expects the literal `auto`. Set a real region for S3.
R2_REGION=auto

# Raw payloads are kept as long as Signals so a rebuild is always possible.
R2_RAW_RETENTION_DAYS=400


# =============================================================================
#  10. AI LAYER                                                     [REQUIRED 1]
# =============================================================================

# The platform is model-agnostic (Design Doc §15). Only `anthropic` has a
# provider implementation today; the rest are accepted by config and will fail
# at first use until services/llm/ grows the adapter.
# options: anthropic | openai | google | bedrock | vertex | azure_openai
#          | ollama | litellm
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=

# Override for self-hosted, proxied or gateway deployments (Ollama, LiteLLM,
# Azure). Leave blank to use the provider's default endpoint.
LLM_BASE_URL=

# Model tiering. The Planner and Critic reason over the whole investigation and
# get the strongest model; per-item work is delegated down. Cheapest tier is used
# for high-volume enrichment (sentiment, entity extraction).
# options: claude-opus-5 | claude-sonnet-5 | claude-haiku-4-5-20251001
LLM_MODEL_PLANNER=claude-opus-5
LLM_MODEL_WORKER=claude-sonnet-5
LLM_MODEL_FAST=claude-haiku-4-5-20251001

# Caps thinking PLUS response text together: thinking is on by default on the
# current Claude generation, so a low ceiling produces a truncated answer that
# looks like a bad model rather than a bad setting. 8192 was too tight for
# planner calls; 16000 leaves room to reason and still answer.
LLM_MAX_OUTPUT_TOKENS=16000

# Applies to one attempt. Retries multiply the wall-clock ceiling by
# LLM_MAX_RETRIES + 1.
LLM_TIMEOUT_SECONDS=120

# Retries handled inside the provider SDK: connection failures, 408/409/429 and
# 5xx, with backoff that honours Retry-After. Set to 0 to make every failure
# reach services/llm/router.py immediately and be shed a tier instead.
LLM_MAX_RETRIES=3

# Caches completions by prompt hash + model id. Turn off when measuring latency.
# options: true | false
LLM_CACHE_ENABLED=true

# 0.0 for reproducible analysis. Range 0.0–2.0. Ignored for models that removed
# sampling parameters (claude-opus-5, claude-sonnet-5) -- sending it there is a 400.
LLM_TEMPERATURE=0.0

# Reasoning depth, the replacement for the removed thinking budget. Blank means
# the provider's own default, which is where the vendor's tuning lives -- set a
# level only once a deployment has measured one that beats it. Higher levels
# spend more of LLM_MAX_OUTPUT_TOKENS on thinking.
# options: low | medium | high | xhigh | max
LLM_EFFORT=


# =============================================================================
#  11. EMBEDDINGS                                                   [REQUIRED 8]
#
#  UNRESOLVED (docs/signal-model.md §9, open question 1). The provider, model and
#  dimension together fix the Qdrant collection geometry. Changing any of them
#  after ingestion begins requires re-embedding every Signal — vectors from
#  different models are not comparable and cannot share a collection.
# =============================================================================

# RECOMMENDED DEFAULT: openai / text-embedding-3-small / 1536.
#
#   Reasoning. Embedding is a *throughput* workload, not a latency one: bulk
#   embedding happens in workers/embedding_worker.py off a Kafka topic where
#   nobody is waiting, and query-time embedding is a single short call dwarfed by
#   the LLM calls around it. So the deciding factor at this stage is cost, and
#   text-embedding-3-small is ~$0.02/M tokens — roughly $10 per million Signals.
#   A dedicated Modal GPU is $400+/month before it embeds anything.
#
#   Switch to self-hosted BAAI/bge-m3 on Modal when any of these becomes true:
#     - sustained ingestion above ~100k Signals/day        (cost crossover)
#     - non-English content above ~20% of the corpus       (bge-m3 is better)
#     - Phase 6 enterprise connectors land                 (content must not leave)
#
#   Switching is a batch job, not a rewrite: scripts/reindex.py re-embeds from
#   PostgreSQL + R2 without re-fetching, and every EmbeddingRef records the model
#   and dimensions it was produced with, so stale vectors are detectable. Run the
#   old and new Qdrant collections side by side during the swap.
#
# options: voyage | openai | cohere | jina | huggingface | modal | local
# Blank disables embedding: ingestion still works and keyword retrieval still
# works, but semantic retrieval returns nothing.
EMBEDDING_PROVIDER=openai

# Must match the provider. Common pairings:
#   voyage       -> voyage-3 (1024), voyage-3-lite (512), voyage-code-3 (1024)
#   openai       -> text-embedding-3-small (1536), text-embedding-3-large (3072)
#   cohere       -> embed-english-v3.0 (1024), embed-multilingual-v3.0 (1024)
#   jina         -> jina-embeddings-v3 (1024)
#   huggingface  -> BAAI/bge-m3 (1024), BAAI/bge-large-en-v1.5 (1024)
#   modal/local  -> whatever infra/modal/ serves, e.g. BAAI/bge-m3
EMBEDDING_MODEL=text-embedding-3-small

# Credential for whichever provider is selected above. Separate from
# ANTHROPIC_API_KEY on purpose — Anthropic has no embeddings API, so this is
# always a different vendor and the two keys rotate independently.
# Not needed when EMBEDDING_PROVIDER is `modal` or `local` behind your own auth.
EMBEDDING_API_KEY=

# Override endpoint. Required for provider=modal or local; leave blank otherwise.
EMBEDDING_BASE_URL=

# MUST equal the model's native output dimension. A mismatch is rejected by
# Qdrant at upsert time, after the embedding spend has already happened.
# common values: 384 | 512 | 768 | 1024 | 1536 | 3072
EMBEDDING_DIMENSIONS=1536

EMBEDDING_BATCH_SIZE=64

# Chunking, applied at enrichment stage 6. Overlap must be < chunk size or the
# splitter makes no forward progress (startup rejects it).
EMBEDDING_MAX_CHARS_PER_CHUNK=2000
EMBEDDING_CHUNK_OVERLAP_CHARS=200


# =============================================================================
#  12. RETRIEVAL TUNING (docs/retrieval.md)
#
#  These are starting points, not tuned values. Validate changes against
#  retrieval/evaluation/ before trusting them.
# =============================================================================

# Candidates requested from each backend before fusion. Higher = better recall,
# more latency. Set RETRIEVAL_GRAPH_CANDIDATES=0 to disable graph expansion.
RETRIEVAL_KEYWORD_CANDIDATES=100
RETRIEVAL_VECTOR_CANDIDATES=100
RETRIEVAL_GRAPH_CANDIDATES=50

# `rrf` is scale-independent and needs no calibration — the right default when
# combining BM25 scores with cosine similarities. `weighted` can beat it but
# only after per-backend score normalization is tuned.
# options: rrf | weighted | max
RETRIEVAL_FUSION_STRATEGY=rrf

# RRF smoothing constant. Lower = trusts top ranks more. 60 is the value from
# the original RRF paper and a reasonable starting point.
RETRIEVAL_RRF_K=60

# options: true | false
RETRIEVAL_RERANK_ENABLED=true

# How deep into the fused list the cross-encoder reranks. Must be >= FINAL_TOP_K
# or results are silently truncated (startup rejects it).
RETRIEVAL_RERANK_DEPTH=50

# Cross-encoder model. Blank uses the LLM tier as a fallback reranker.
# examples: BAAI/bge-reranker-v2-m3 | cohere/rerank-v3.5 | jina-reranker-v2
RETRIEVAL_RERANK_MODEL=

RETRIEVAL_FINAL_TOP_K=20
RETRIEVAL_MIN_SCORE=0.0


# =============================================================================
#  13. AGENTS / ORCHESTRATION (docs/agent-system.md)
# =============================================================================

# Hard cap on graph steps. Prevents a planning loop from running forever.
INVESTIGATION_MAX_STEPS=50

INVESTIGATION_TIMEOUT_SECONDS=1800

# Output-token budget per investigation. The run parks at its checkpoint when
# exhausted rather than being killed mid-report.
INVESTIGATION_TOKEN_BUDGET=1000000

# How many times the Critic may send work back before the report ships as
# `completed_with_findings`. 0 disables the revision loop entirely.
MAX_CRITIC_REVISIONS=2

# Concurrent agent nodes during the parallel retrieval fan-out.
AGENT_MAX_PARALLEL=4

# Durable checkpointing to Postgres. Off makes runs non-resumable — a restart
# loses in-flight investigations.
# options: true | false
AGENT_CHECKPOINT_ENABLED=true


# =============================================================================
#  14. CONNECTORS (docs/connector-spec.md)
# =============================================================================

# Fallback when a connector declares no policy of its own.
CONNECTOR_DEFAULT_RATE_LIMIT_PER_MINUTE=60

# Global cap across every worker replica — the limiter is Redis-backed, so this
# is a real ceiling rather than a per-process one.
CONNECTOR_MAX_CONCURRENCY=8

CONNECTOR_REQUEST_TIMEOUT_SECONDS=30
CONNECTOR_MAX_RETRIES=5
CONNECTOR_BACKOFF_BASE_SECONDS=1.0
CONNECTOR_BACKOFF_MAX_SECONDS=60.0

# How long a content hash stays in the "already seen" set. 7 days.
CONNECTOR_DEDUP_TTL_SECONDS=604800

# Hamming distance for 64-bit SimHash near-duplicate clustering. Higher clusters
# more aggressively. Range 0–64; 3 is the documented default.
CONNECTOR_SIMHASH_DISTANCE_THRESHOLD=3

INGESTION_BATCH_SIZE=100


# -----------------------------------------------------------------------------
#  14a. Connector credentials — Phase 1                             [REQUIRED 2-4]
#
#  Only Reddit, RSS and a news API are in Phase 1. Credentials for later phases
#  are listed in 14b so you know what each will eventually need.
# -----------------------------------------------------------------------------

# reddit.com/prefs/apps -> "create another app" -> type: script
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit requires a descriptive UA and rate-limits generic ones harshly.
REDDIT_USER_AGENT=omnisense/0.1 (by /u/your-reddit-username)

# RSS needs no credentials. Comma-separated feed URLs to poll.
RSS_FEED_URLS=

# newsapi.org, or whichever provider connectors/news/news_api.py targets.
NEWS_API_KEY=

# GDELT is public and unauthenticated but high-volume. Off by default.
# options: true | false
GDELT_ENABLED=false


# -----------------------------------------------------------------------------
#  14b. Connector credentials — later phases (leave blank for now)
#
#  ToS WARNING: the four marked (!) have no viable official API for this use
#  case. Implementing them means scraping, which requires a documented legal
#  review before the connector may be enabled — see docs/connector-spec.md §9
#  and docs/security-and-privacy.md. They are listed for completeness only.
# -----------------------------------------------------------------------------

# -- Phase 2: social ----------------------------------------------------------
X_BEARER_TOKEN=
YOUTUBE_API_KEY=
INSTAGRAM_ACCESS_TOKEN=          # (!) ToS review required
TIKTOK_CLIENT_KEY=               # (!) ToS review required
TIKTOK_CLIENT_SECRET=            # (!)
LINKEDIN_CLIENT_ID=              # (!) ToS review required
LINKEDIN_CLIENT_SECRET=          # (!)

# -- Phase 2: reviews ---------------------------------------------------------
AMAZON_ACCESS_KEY=               # (!) ToS review required
AMAZON_SECRET_KEY=               # (!)
PLAY_STORE_SERVICE_ACCOUNT_JSON= # path to the service-account key file
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY_PATH=
TRUSTPILOT_API_KEY=
GOOGLE_PLACES_API_KEY=           # backs connectors/reviews/google_reviews.py

# -- Phase 2: research --------------------------------------------------------
# arXiv and Papers with Code are open. Semantic Scholar raises rate limits with
# a free key.
SEMANTIC_SCHOLAR_API_KEY=

# -- Phase 6: enterprise ------------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_API_TOKEN=
NOTION_API_KEY=
GITHUB_TOKEN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_INSTANCE_URL=
HUBSPOT_ACCESS_TOKEN=


# =============================================================================
#  15. OBSERVABILITY (docs/observability.md)
# =============================================================================

# LangSmith traces prompts, tool calls, token counts and per-agent cost. Highly
# recommended while developing agents — a multi-agent run is close to
# undebuggable without it.
# options: true | false
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=omnisense

# OTLP collector endpoint. Blank disables trace export (spans are still created,
# just not shipped).
OTEL_EXPORTER_OTLP_ENDPOINT=

# Set per process so traces are attributable.
# convention: omnisense-api | omnisense-worker | omnisense-scheduler
OTEL_SERVICE_NAME=omnisense-api

# Trace sample ratio, 0.0–1.0. Keep 1.0 locally; lower it under real traffic.
OTEL_SAMPLE_RATIO=1.0

# options: true | false
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
